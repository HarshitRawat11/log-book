# Copy to .env.local and fill in. .env.local is gitignored.
#
# Both of these are PUBLIC by design: they ship inside the JS bundle and are
# visible to anyone who opens devtools. The database is protected by Row Level
# Security, not by hiding these values.
#
# The service_role key must NEVER appear here, in the repo, or in any build
# output. It bypasses RLS entirely.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
