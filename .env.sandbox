# Local UI verification ONLY. Never used by a build or a deploy.
#
# Points Supabase at a dead port so `npm run dev -- --mode sandbox` physically
# cannot reach the real project: the app runs offline-first against IndexedDB,
# which is the whole surface worth eyeballing, and no seeded test row can leak
# into live data. Vite loads .env.[mode] after .env.local, so this wins.
#
# Nothing secret here. The key is a syntactically valid throwaway.
VITE_SUPABASE_URL=http://127.0.0.1:9
VITE_SUPABASE_ANON_KEY=sandbox-not-a-real-key
