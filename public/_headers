# Cloudflare Pages headers. The Netlify equivalents lived in netlify.toml; this
# is the same set, translated.
#
# One syntax trap worth naming: this format has NO line continuation. The CSP
# below must stay on a single line however long it gets — a wrapped value is
# read as a new rule and the policy silently degrades.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; manifest-src 'self'; worker-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://world.openfoodfacts.org https://search.openfoodfacts.org

# Netlify served .webmanifest as application/octet-stream, which makes Chrome
# ignore the manifest and drop the install prompt with no error anywhere. Pinned
# here too rather than trusting Cloudflare's default — it is verified after
# deploy, because a wrong value is invisible until the install prompt vanishes.
/manifest.webmanifest
  Content-Type: application/manifest+json

# The service worker must never be cached, or a deploy never reaches a phone
# that already registered the old one.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Hashed filenames, so these are safe to cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
